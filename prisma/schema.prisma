// PINFAB Manager — domain schema
// Complete domain model migrated from day one (see plan): later phases only
// add migrations if real-world details force a change. JSON columns
// (ReportTemplate.structure, Report.content, AiJob.payload) are the flex points.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  MANAGER
  TECHNICIAN
}

enum Locale {
  it
  en
}

enum ClientType {
  SHIPOWNER
  SHIPYARD
  OPERATOR
  OTHER
}

enum LocationKind {
  SHIPYARD
  DRYDOCK
  PORT
  ANCHORAGE
}

enum ProjectType {
  INSTALLATION
  SERVICE
  DRYDOCK_WORKS
  INSPECTION
  WARRANTY
}

enum ProjectStatus {
  PLANNED
  MOBILIZING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum AssignmentRole {
  LEAD
  TECHNICIAN
  SUPPORT
}

enum AssignmentStatus {
  PLANNED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
  VACATION
  TRAINING
}

enum DailyLogStatus {
  DRAFT
  SUBMITTED
  ANALYZED
}

enum MeasurementType {
  TOLERANCE
  CLEARANCE
  OIL_LEVEL
  OIL_CHANGE
  PRESSURE
  TEMPERATURE
  TORQUE
  OTHER
}

enum FinPosition {
  PORT
  STARBOARD
}

enum PhotoCategory {
  FIN_CONDITION
  HULL_OPENING
  SEAL
  ACTUATOR
  HYDRAULICS
  DAMAGE
  GENERAL
  DOCUMENT
}

enum RecordingStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  ANALYZED
  FAILED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CriticalitySource {
  DAILY_LOG
  MEETING
  PHOTO
  MANUAL
}

enum CriticalityStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum CriticalityCategory {
  SCHEDULE_CONFLICT
  TOLERANCE_OUT_OF_SPEC
  LEAK
  DAMAGE
  SAFETY
  LOGISTICS
  QUALITY
  OTHER
}

enum DirectiveStatus {
  SENT
  READ
  ACKNOWLEDGED
  DONE
}

enum ReportStatus {
  DRAFT
  GENERATED
  IN_REVIEW
  FINALIZED
  SIGNED
  COUNTERSIGNED
  ARCHIVED
}

enum SignatureKind {
  TECHNICIAN
  INSPECTOR
  CLIENT
  MANAGER
}

enum SignatureMethod {
  CANVAS
  UPLOAD
}

enum NotificationType {
  CRITICALITY
  DIRECTIVE
  ASSIGNMENT
  REPORT
  SYSTEM
}

enum JobType {
  DAILY_LOG_ANALYSIS
  TRANSCRIPTION
  MEETING_ANALYSIS
  REPORT_GENERATION
  PHOTO_ANALYSIS
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ───────────────────────────── People ─────────────────────────────

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           Role           @default(TECHNICIAN)
  locale         Locale         @default(en)
  active         Boolean        @default(true)
  technician     Technician?
  notifications  Notification[]
  directivesSent Directive[]    @relation("DirectiveFrom")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Technician {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String?
  homeBase      String? // city, country
  passportNote  String?
  skills        TechnicianSkill[]
  availability  Availability[]
  assignments   Assignment[]
  dailyLogs     DailyLog[]
  recordings    MeetingRecording[]
  directives    Directive[]        @relation("DirectiveTo")
  criticalities Criticality[]
}

model Skill {
  id          String            @id @default(cuid())
  name        String            @unique
  technicians TechnicianSkill[]
}

model TechnicianSkill {
  technicianId String
  skillId      String
  level        Int        @default(3) // 1-5
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([technicianId, skillId])
}

model Availability {
  id           String           @id @default(cuid())
  technicianId String
  technician   Technician       @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  type         AvailabilityType
  fromDate     DateTime
  toDate       DateTime
  notes        String?
}

// ─────────────────── Clients / Vessels / Locations ───────────────────

model Client {
  id       String     @id @default(cuid())
  name     String
  type     ClientType @default(SHIPOWNER)
  country  String?
  contacts Json? // [{name, role, email, phone}]
  notes    String?
  vessels  Vessel[]
  projects Project[]
}

model Vessel {
  id              String    @id @default(cuid())
  name            String
  imoNumber       String?   @unique
  vesselType      String?
  flag            String?
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id])
  stabilizerModel String?
  finCount        Int?      @default(2)
  notes           String?
  projects        Project[]
}

model Location {
  id       String       @id @default(cuid())
  name     String
  kind     LocationKind @default(SHIPYARD)
  city     String?
  country  String
  lat      Float
  lng      Float
  timezone String?
  projects Project[]
}

// ───────────────────────────── Projects ─────────────────────────────

model Project {
  id            String                @id @default(cuid())
  code          String                @unique // e.g. PF-2026-014
  title         String
  type          ProjectType
  status        ProjectStatus         @default(PLANNED)
  complexity    Int                   @default(3) // 1-5
  vesselId      String
  vessel        Vessel                @relation(fields: [vesselId], references: [id])
  clientId      String
  client        Client                @relation(fields: [clientId], references: [id])
  locationId    String
  location      Location              @relation(fields: [locationId], references: [id])
  startDate     DateTime
  endDate       DateTime
  actualStart   DateTime?
  actualEnd     DateTime?
  description   String?
  milestones    Milestone[]
  assignments   Assignment[]
  dailyLogs     DailyLog[]
  recordings    MeetingRecording[]
  criticalities Criticality[]
  directives    Directive[]
  photos        Photo[]
  reports       Report[]
  standards     MeasurementStandard[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
}

// Milestones feed AI schedule-conflict analysis (painting day, undocking, sea trial…)
model Milestone {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  dueDate   DateTime
  done      Boolean  @default(false)
}

model Assignment {
  id               String           @id @default(cuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technicianId     String
  technician       Technician       @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  role             AssignmentRole   @default(TECHNICIAN)
  status           AssignmentStatus @default(PLANNED)
  startDate        DateTime
  endDate          DateTime
  travelOutDate    DateTime?
  travelReturnDate DateTime?
  notes            String?

  @@unique([projectId, technicianId])
}

// ─────────────────── Field data (daily logs) ───────────────────

// Range standards measurements are validated against; projectId null = global default
model MeasurementStandard {
  id           String          @id @default(cuid())
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         MeasurementType
  name         String // "Fin shaft radial clearance"
  unit         String // "mm", "bar", "L"
  minValue     Float?
  maxValue     Float?
  measurements Measurement[]
}

model DailyLog {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technicianId  String
  technician    Technician     @relation(fields: [technicianId], references: [id])
  logDate       DateTime       @db.Date
  status        DailyLogStatus @default(DRAFT)
  notes         String?
  workHours     Float?
  submittedAt   DateTime?
  measurements  Measurement[]
  photos        Photo[]
  criticalities Criticality[]

  @@unique([projectId, technicianId, logDate])
}

model Measurement {
  id          String               @id @default(cuid())
  dailyLogId  String
  dailyLog    DailyLog             @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  standardId  String?
  standard    MeasurementStandard? @relation(fields: [standardId], references: [id])
  type        MeasurementType
  name        String
  value       Float
  unit        String
  finPosition FinPosition?
  withinSpec  Boolean? // computed at save vs standard
  notes       String?
}

model Photo {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyLogId String?
  dailyLog   DailyLog?     @relation(fields: [dailyLogId], references: [id])
  category   PhotoCategory @default(GENERAL)
  storageKey String        @unique
  mimeType   String
  sizeBytes  Int
  caption    String?
  aiAnalysis Json?
  createdAt  DateTime      @default(now())
}

// ─────────────────── Meetings / transcription ───────────────────

model MeetingRecording {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician      @relation(fields: [technicianId], references: [id])
  recordedAt   DateTime        @default(now())
  storageKey   String          @unique
  mimeType     String
  durationSec  Int?
  status       RecordingStatus @default(UPLOADED)
  transcript   Transcript?
}

model Transcript {
  id            String           @id @default(cuid())
  recordingId   String           @unique
  recording     MeetingRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  text          String
  language      String?
  provider      String           @default("openai-whisper-1")
  criticalities Criticality[]
  createdAt     DateTime         @default(now())
}

// ─────────────────── Criticalities / directives ───────────────────

model Criticality {
  id                String              @id @default(cuid())
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  severity          Severity
  category          CriticalityCategory
  status            CriticalityStatus   @default(OPEN)
  source            CriticalitySource
  title             String
  description       String
  recommendedAction String?
  finPosition       FinPosition?
  dailyLogId        String?
  dailyLog          DailyLog?           @relation(fields: [dailyLogId], references: [id])
  transcriptId      String?
  transcript        Transcript?         @relation(fields: [transcriptId], references: [id])
  technicianId      String?
  technician        Technician?         @relation(fields: [technicianId], references: [id])
  aiConfidence      Float?
  aiRaw             Json?
  resolvedAt        DateTime?
  directives        Directive[]
  createdAt         DateTime            @default(now())

  @@index([status, severity])
}

model Directive {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criticalityId  String?
  criticality    Criticality?    @relation(fields: [criticalityId], references: [id])
  fromUserId     String
  fromUser       User            @relation("DirectiveFrom", fields: [fromUserId], references: [id])
  toTechnicianId String
  toTechnician   Technician      @relation("DirectiveTo", fields: [toTechnicianId], references: [id])
  message        String
  status         DirectiveStatus @default(SENT)
  acknowledgedAt DateTime?
  createdAt     DateTime         @default(now())
}

// ─────────────────────────── Reports ───────────────────────────

// structure: [{key, titleEn, titleIt, kind: "text"|"table"|"measurements"|"photos"|"signatures", aiHint}]
model ReportTemplate {
  id        String   @id @default(cuid())
  name      String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  structure Json
  reports   Report[]
}

model Report {
  id                   String         @id @default(cuid())
  projectId            String
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId           String
  template             ReportTemplate @relation(fields: [templateId], references: [id])
  status               ReportStatus   @default(DRAFT)
  version              Int            @default(1)
  content              Json // {sectionKey: text/structured rows}
  pdfStorageKey        String? // unsigned generated PDF
  signedScanStorageKey String? // uploaded phone-scanned signed copy
  finalPdfStorageKey   String? // countersigned archive PDF
  signatures           Signature[]
  generatedAt          DateTime?
  finalizedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Signature {
  id              String          @id @default(cuid())
  reportId        String
  report          Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind            SignatureKind
  method          SignatureMethod
  signerName     String
  signerTitle     String?
  imageStorageKey String // PNG from signature_pad or cropped scan
  signedAt        DateTime        @default(now())
}

// ─────────────────── Notifications / jobs ───────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// Postgres-backed job queue: claimed with FOR UPDATE SKIP LOCKED by the
// in-process worker (src/server/jobs/worker.ts), survives redeploys.
model AiJob {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  payload     Json // {dailyLogId} | {recordingId} | {reportId, projectId}
  result      Json?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lockedBy    String?
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
}
